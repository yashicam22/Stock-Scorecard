          ]
        }
      ],
      "source": [
        "TICKERS = [\n",
        "    'NVDA',\n",
        "    'TSLA',\n",
        "    'AAPL',\n",
        "    'MSFT',\n",
        "    'AMD',\n",
        "    'META',\n",
        "    'GOOGL',\n",
        "    'AMZN',\n",
        "    'AVGO',\n",
        "    'COST',\n",
        "    'JPM',\n",
        "    'XOM',\n",
        "    'LLY'\n",
        "]\n",
        "\n",
        "print(TICKERS)\n",
        "print(\"Number of stocks:\", len(TICKERS))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "vGXPBZs_by4W",
        "outputId": "452c1832-dfc8-400c-8667-a75dd88a028c"
      },
      "outputs": [
        {
          "name": "stderr",
          "output_type": "stream",
          "text": [
            "[*********************100%***********************]  13 of 13 completed\n"
          ]
        }
      ],
      "source": [
        "import yfinance as yf\n",
        "\n",
        "data = yf.download(\n",
        "    TICKERS,\n",
        "    start='2019-01-01',\n",
        "    end='2026-01-01',\n",
        "    auto_adjust=False,\n",
        "    group_by='ticker'\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "nCzWQTNGb6ms",
        "outputId": "f5186501-63d2-4b0f-86ba-5d13f6f7788a"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Price       Date     Open     High      Low    Close  Adj Close     Volume  \\\n",
            "0     2019-01-02  3.26600  3.46200  3.25125  3.40550   3.373052  508752000   \n",
            "1     2019-01-03  3.34475  3.37900  3.19225  3.19975   3.169262  705552000   \n",
            "2     2019-01-04  3.27350  3.44325  3.24250  3.40475   3.372309  585620000   \n",
            "3     2019-01-07  3.46250  3.62225  3.41075  3.58500   3.550843  709160000   \n",
            "4     2019-01-08  3.66725  3.66950  3.42250  3.49575   3.462442  786016000   \n",
            "\n",
            "Price Ticker  \n",
            "0       NVDA  \n",
            "1       NVDA  \n",
            "2       NVDA  \n",
            "3       NVDA  \n",
            "4       NVDA  \n",
            "(22880, 8)\n"
          ]
        }
      ],
      "source": [
        "frames = []\n",
        "\n",
        "for ticker in TICKERS:\n",
        "    temp = data[ticker].copy()\n",
        "    temp['Ticker'] = ticker\n",
        "    temp.index.name = 'Date'\n",
        "    frames.append(temp)\n",
        "\n",
        "df = pd.concat(frames)\n",
        "\n",
        "df = df.reset_index()\n",
        "\n",
        "print(df.head())\n",
        "print(df.shape)"
      ]
    },
