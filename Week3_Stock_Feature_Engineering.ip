      "source": [
        "df['Date'] = pd.to_datetime(df['Date'])\n",
        "\n",
        "df = df.sort_values(\n",
        "    ['Ticker', 'Date']\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(df[['Date', 'Ticker', 'Close', 'High', 'Low']].head(10))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LPX7gpMamavM"
      },
      "outputs": [],
      "source": [
        "import numpy as np\n",
        "\n",
        "def make_labels(close, high, low):\n",
        "    n = len(close)\n",
        "\n",
        "    # Start with NaN because the last 15 days cannot be answered\n",
        "    out = np.full(n, np.nan)\n",
        "\n",
        "    # Last 15 days are left as NaN\n",
        "    for i in range(n - 15):\n",
        "\n",
        "        # Default = failed\n",
        "        out[i] = 0\n",
        "\n",
        "        # Look at the next 15 trading days\n",
        "        for j in range(1, 16):\n",
        "\n",
        "            # -3% stop happens first → failed\n",
        "            if low[i + j] <= close[i] * 0.97:\n",
        "                break\n",
        "\n",
        "            # +5% target happens first → worked\n",
        "            if high[i + j] >= close[i] * 1.05:\n",
        "                out[i] = 1\n",
        "                break\n",
        "\n",
        "    return out"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vb1venafmsZZ"
      },
      "outputs": [],
      "source": [
        "df['Label'] = np.nan\n",
        "\n",
        "for ticker, idx in df.groupby('Ticker').groups.items():\n",
        "\n",
        "    # Get one stock's data\n",
        "    g = df.loc[idx].sort_values('Date')\n",
        "\n",
        "    # Create labels for that stock\n",
        "    labels = make_labels(\n",
        "        g['Close'].values,\n",
        "        g['High'].values,\n",
        "        g['Low'].values\n",
        "    )\n",
        "\n",
        "    # Put labels back into original dataframe\n",
        "    df.loc[g.index, 'Label'] = labels"
      ]
    },
