      "source": [
        "# Typical Price\n",
        "tp_5m = (\n",
        "    nvda_5m['High'] +\n",
        "    nvda_5m['Low'] +\n",
        "    nvda_5m['Close']\n",
        ") / 3\n",
        "\n",
        "# 20-period rolling VWAP\n",
        "nvda_5m['VWAP20'] = (\n",
        "    (tp_5m * nvda_5m['Volume']).rolling(20).sum()\n",
        "    / nvda_5m['Volume'].rolling(20).sum()\n",
        ")\n",
        "\n",
        "# Check the values\n",
        "nvda_5m[['Close', 'VWAP20']].tail(20)"
      ]
    },
