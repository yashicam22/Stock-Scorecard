            "9       AAPL 2019-01-15  38.267502        NaN\n",
            "10      AAPL 2019-01-16  38.735001        NaN\n",
            "11      AAPL 2019-01-17  38.965000        NaN\n",
            "12      AAPL 2019-01-18  39.205002        NaN\n",
            "13      AAPL 2019-01-22  38.325001        NaN\n",
            "14      AAPL 2019-01-23  38.480000  11.014535\n",
            "15      AAPL 2019-01-24  38.174999  10.873001\n",
            "16      AAPL 2019-01-25  39.439999  15.710740\n",
            "17      AAPL 2019-01-28  39.075001  15.450154\n",
            "18      AAPL 2019-01-29  38.669998  15.149882\n",
            "19      AAPL 2019-01-30  41.312500  25.344823\n",
            "20      AAPL 2019-01-31  41.610001  26.416757\n",
            "21      AAPL 2019-02-01  41.630001  26.493171\n",
            "22      AAPL 2019-02-04  42.812500  31.052078\n",
            "23      AAPL 2019-02-05  43.544998  33.791369\n",
            "24      AAPL 2019-02-06  43.560001  33.849340\n"
          ]
        }
      ],
      "source": [
        "# RSI14\n",
        "\n",
        "def calculate_rsi(series, period=14):\n",
        "    delta = series.diff()\n",
        "\n",
        "    gain = delta.clip(lower=0)\n",
        "    loss = -delta.clip(upper=0)\n",
        "\n",
        "    avg_gain = gain.ewm(\n",
        "        alpha=1/period,\n",
        "        adjust=False,\n",
        "        min_periods=period\n",
        "    ).mean()\n",
        "\n",
        "    avg_loss = loss.ewm(\n",
        "        alpha=1/period,\n",
        "        adjust=False,\n",
        "        min_periods=period\n",
        "    ).mean()\n",
        "\n",
        "    rs = avg_gain / avg_loss\n",
        "\n",
        "    rsi = 100 - (100 / (1 + rs))\n",
        "\n",
        "    return rsi\n",
        "\n",
        "\n",
        "df['RSI14'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: calculate_rsi(s, 14))\n",
        ")\n",
        "\n",
        "print(df[['Ticker', 'Date', 'Close', 'RSI14']].head(25))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "de0fXQ6ThpHo",
        "outputId": "e0b2f893-a53e-43ad-c889-dccfb66ef47b"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Indicators:\n",
            "['SMA20', 'SMA50', 'EMA20', 'VWAP20', 'MACD', 'Signal', 'RSI14']\n"
          ]
        }
      ],
      "source": [
        "indicators = [\n",
        "    'SMA20',\n",
        "    'SMA50',\n",
        "    'EMA20',\n",
        "    'VWAP20',\n",
        "    'MACD',\n",
        "    'Signal',\n",
        "    'RSI14'\n",
        "]\n",
        "\n",
        "print(\"Indicators:\")\n",
        "print(df[indicators].columns.tolist())"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "hY5WXTREjkHs"
      },
      "outputs": [],
      "source": [
        "# ==========================================\n",
        "# Y1 — Create 10 Model Features\n",
        "# ==========================================\n",
        "\n",
        "df['ret_5d'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .pct_change(5)\n",
        ")\n",
        "\n",
        "df['ret_20d'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .pct_change(20)\n",
        ")\n",
        "\n",
        "df['px_sma20'] = (\n",
        "    df['Close'] / df['SMA20'] - 1\n",
        ")\n",
        "\n",
        "df['px_sma50'] = (\n",
        "    df['Close'] / df['SMA50'] - 1\n",
        ")\n",
        "\n",
        "df['ema_sma'] = (\n",
        "    df['EMA20'] / df['SMA20'] - 1\n",
        ")\n",
        "\n",
        "df['px_vwap'] = (\n",
        "    df['Close'] / df['VWAP20'] - 1\n",
        ")\n",
        "\n",
        "df['macd_n'] = (\n",
        "    (df['MACD'] - df['Signal']) / df['Close']\n",
        ")\n",
        "\n",
        "df['vol_20'] = (\n",
        "    df.groupby('Ticker')['Return']\n",
        "      .transform(lambda s: s.rolling(20).std())\n",
        ")\n",
        "\n",
        "df['rel_vol'] = (\n",
        "    df['Volume'] /\n",
        "    df.groupby('Ticker')['Volume']\n",
        "      .transform(lambda s: s.rolling(20).mean())\n",
        ")\n",
        "\n",
        "# RSI14 already exists"
      ]
    },
