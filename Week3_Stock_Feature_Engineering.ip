          ]
        }
      ],
      "source": [
        "if isinstance(nvda_5m.columns, pd.MultiIndex):\n",
        "    nvda_5m.columns = nvda_5m.columns.get_level_values(0)\n",
        "\n",
        "print(nvda_5m.columns)"
      ]
