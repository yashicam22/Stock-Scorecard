      ],
      "source": [
        "df['TP'] = (df['High'] + df['Low'] + df['Close']) / 3\n",
        "\n",
        "df['VWAP20'] = (\n",
        "    df.groupby('Ticker')\n",
        "      .apply(\n",
        "          lambda g: (\n",
        "              (g['TP'] * g['Volume']).rolling(20).sum()\n",
        "              / g['Volume'].rolling(20).sum()\n",
        "          ),\n",
        "          include_groups=False\n",
        "      )\n",
        "      .reset_index(level=0, drop=True)\n",
        ")\n",
        "\n",
        "print(df[['Ticker', 'Date', 'Close', 'VWAP20']].head(25))"
      ]
    },
