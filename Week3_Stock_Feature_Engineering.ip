        "import mplfinance as mpf\n",
        "\n",
        "chart_5m = nvda_5m.dropna(subset=['VWAP20']).copy()\n",
        "\n",
        "mpf.plot(\n",
        "    chart_5m.tail(500),\n",
        "    type='candle',\n",
        "    style='yahoo',\n",
        "    volume=True,\n",
        "    addplot=mpf.make_addplot(\n",
        "        chart_5m['VWAP20'].tail(500),\n",
        "        color='orange',\n",
        "        width=2\n",
        "    ),\n",
        "    title='NVDA 5-Minute Candlestick Chart with VWAP20',\n",
        "    ylabel='Price (USD)',\n",
        "    figsize=(16, 8),\n",
        "    tight_layout=True\n",
        ")"
      ]
    },
