      "source": [
        "nvda_15m = nvda_15m.copy()\n",
        "\n",
        "if isinstance(nvda_15m.columns, pd.MultiIndex):\n",
        "    nvda_15m.columns = nvda_15m.columns.get_level_values(0)\n",
        "\n",
        "nvda_15m.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "PsQ1W43SNt1U"
      },
      "outputs": [],
      "source": [
        "change = nvda_15m['Close'].diff()\n",
        "\n",
        "gain = change.clip(lower=0)\n",
        "loss = -change.clip(upper=0)\n",
        "\n",
        "avg_gain = gain.rolling(14).mean()\n",
        "avg_loss = loss.rolling(14).mean()\n",
        "\n",
        "rs = avg_gain / avg_loss\n",
        "\n",
        "nvda_15m['RSI14'] = 100 - (100 / (1 + rs))"
      ]
    },
