    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "LocQmJXVzOPK"
      },
      "outputs": [],
      "source": [
        "tp = (nvda_daily['High'] + nvda_daily['Low'] + nvda_daily['Close']) / 3"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ang3Br-XziXv"
      },
      "outputs": [],
      "source": [
        "nvda_daily['VWAP20'] = (\n",
        "    (tp * nvda_daily['Volume']).rolling(20).sum()\n",
        "    / nvda_daily['Volume'].rolling(20).sum()\n",
        ")"
      ]
    },
