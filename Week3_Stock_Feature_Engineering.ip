      "source": [
        "df['Date'] = pd.to_datetime(df['Date'])\n",
        "\n",
        "df = df.sort_values(\n",
        "    ['Ticker', 'Date']\n",
        ").reset_index(drop=True)\n",
        "\n",
        "print(df.head())\n",
        "print(df.dtypes)"
      ]
