        "id": "OAr1jcLShgsQ",
        "outputId": "b970df54-2d19-4379-a707-e084b9e6e859"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Price Ticker       Date      Close      RSI14\n",
            "0       AAPL 2019-01-02  39.480000        NaN\n",
            "1       AAPL 2019-01-03  35.547501        NaN\n",
            "2       AAPL 2019-01-04  37.064999        NaN\n",
            "3       AAPL 2019-01-07  36.982498        NaN\n",
            "4       AAPL 2019-01-08  37.687500        NaN\n",
            "5       AAPL 2019-01-09  38.327499        NaN\n",
