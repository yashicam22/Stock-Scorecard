      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "WzKrhNpRIaYc"
      },
      "outputs": [],
      "source": [
        "df['SMA20'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.rolling(20).mean())\n",
        ")\n",
        "\n",
        "df['SMA50'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.rolling(50).mean())\n",
        ")\n",
        "\n",
        "df['EMA20'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.ewm(span=20, adjust=False).mean())\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XmaqLGifIdFQ"
      },
      "outputs": [],
      "source": [
        "df['TP'] = (df['High'] + df['Low'] + df['Close']) / 3\n",
        "\n",
        "df['VWAP20'] = (\n",
        "    df.groupby('Ticker')\n",
        "      .apply(\n",
        "          lambda g: (g['TP'] * g['Volume']).rolling(20).sum()\n",
        "                    / g['Volume'].rolling(20).sum(),\n",
        "          include_groups=False\n",
        "      )\n",
        "      .reset_index(level=0, drop=True)\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "JRwAuLTYIgzi"
      },
      "outputs": [],
      "source": [
        "df['EMA12'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.ewm(span=12, adjust=False).mean())\n",
        ")\n",
        "\n",
        "df['EMA26'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.ewm(span=26, adjust=False).mean())\n",
        ")\n",
        "\n",
        "df['MACD'] = df['EMA12'] - df['EMA26']\n",
        "\n",
        "df['Signal'] = (\n",
        "    df.groupby('Ticker')['MACD']\n",
        "      .transform(lambda s: s.ewm(span=9, adjust=False).mean())\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Zu2arus3Ijre"
      },
      "outputs": [],
      "source": [
        "def calculate_rsi(series, period=14):\n",
        "    delta = series.diff()\n",
        "\n",
        "    gain = delta.clip(lower=0)\n",
        "    loss = -delta.clip(upper=0)\n",
        "\n",
        "    avg_gain = gain.rolling(period).mean()\n",
        "    avg_loss = loss.rolling(period).mean()\n",
        "\n",
        "    rs = avg_gain / avg_loss\n",
        "\n",
        "    return 100 - (100 / (1 + rs))\n",
        "\n",
        "\n",
        "df['RSI14'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(calculate_rsi)\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "IlRz0wSrImA2"
      },
      "outputs": [],
      "source": [
        "df['ret_5d'] = (\n",
        "    df.groupby('Ticker')['Close'].pct_change(5)\n",
        ")\n",
        "\n",
        "df['ret_20d'] = (\n",
        "    df.groupby('Ticker')['Close'].pct_change(20)\n",
        ")\n",
        "\n",
        "df['px_sma20'] = df['Close'] / df['SMA20'] - 1\n",
        "\n",
        "df['px_sma50'] = df['Close'] / df['SMA50'] - 1\n",
        "\n",
        "df['ema_sma'] = df['EMA20'] / df['SMA20'] - 1\n",
        "\n",
        "df['px_vwap'] = df['Close'] / df['VWAP20'] - 1\n",
        "\n",
        "df['macd_n'] = (\n",
        "    (df['MACD'] - df['Signal']) / df['Close']\n",
        ")\n",
        "\n",
        "df['Return'] = (\n",
        "    df.groupby('Ticker')['Close'].pct_change()\n",
        ")\n",
        "\n",
        "df['vol_20'] = (\n",
        "    df.groupby('Ticker')['Return']\n",
        "      .transform(lambda s: s.rolling(20).std())\n",
        ")\n",
        "\n",
        "df['rel_vol'] = (\n",
        "    df['Volume'] /\n",
        "    df.groupby('Ticker')['Volume']\n",
        "      .transform(lambda s: s.rolling(20).mean())\n",
        ")"
      ]
    },
