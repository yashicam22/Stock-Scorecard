      "source": [
        "nvda_daily = nvda_daily.copy()\n",
        "\n",
        "if isinstance(nvda_daily.columns, pd.MultiIndex):\n",
        "    nvda_daily.columns = nvda_daily.columns.get_level_values(0)\n",
        "\n",
        "nvda_daily.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "q2zlavIVMRIy",
        "outputId": "59ecdbc9-f8da-4465-dfac-42859da7b115"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Index(['Adj Close', 'Close', 'High', 'Low', 'Open', 'Volume'], dtype='object', name='Price')\n"
          ]
        }
      ],
      "source": [
        "print(nvda_daily.columns)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "TmT3RMSZMW1f"
      },
      "outputs": [],
      "source": [
        "change = nvda_daily['Close'].diff()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "cIJQICojMbDS"
      },
      "outputs": [],
      "source": [
        "gain = change.clip(lower=0)\n",
        "loss = -change.clip(upper=0)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "D4TmZQxbMfqg"
      },
      "outputs": [],
      "source": [
        "avg_gain = gain.rolling(14).mean()\n",
        "avg_loss = loss.rolling(14).mean()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "4rjDIT9kMiip"
      },
      "outputs": [],
      "source": [
        "rs = avg_gain / avg_loss\n",
        "\n",
        "nvda_daily['RSI14'] = 100 - (100 / (1 + rs))"
      ]
    },
