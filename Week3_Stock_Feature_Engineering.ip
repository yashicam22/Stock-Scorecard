      "source": [
        "# SMA20 and SMA50\n",
        "\n",
        "df['SMA20'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.rolling(20).mean())\n",
        ")\n",
        "\n",
        "df['SMA50'] = (\n",
        "    df.groupby('Ticker')['Close']\n",
        "      .transform(lambda s: s.rolling(50).mean())\n",
        ")\n",
        "\n",
        "print(df[['Ticker', 'Date', 'Close', 'SMA20', 'SMA50']].head(60))"
      ]
    },
