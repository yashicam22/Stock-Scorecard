      "source": [
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "nvda_5m = yf.download(\n",
        "    \"NVDA\",\n",
        "    period=\"60d\",\n",
        "    interval=\"5m\",\n",
        "    auto_adjust=False\n",
        ")\n",
        "\n",
        "print(nvda_5m.head())"
      ]
    },
