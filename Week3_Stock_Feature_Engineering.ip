        "    linewidth=2\n",
        ")\n",
        "\n",
        "plt.title('NVDA Daily Price vs VWAP20', fontsize=16)\n",
        "plt.xlabel('Date')\n",
        "plt.ylabel('Price (USD)')\n",
        "\n",
        "plt.legend()\n",
        "plt.grid(True, alpha=0.3)\n",
        "\n",
        "plt.show()"
      ]
